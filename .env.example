# ==============================================================================
# TrustFed: Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' in your local development environment:
#      cp .env.example .env
# 2. Never commit '.env' or real API keys to version control.
# 3. In production, configure environment variables via your cloud host or secret manager.
# ==============================================================================

# Application Environment: 'development', 'staging', or 'production'
APP_ENV=development

# Server Host & Port
API_HOST=127.0.0.1
API_PORT=8001

# Allowed CORS Origins (comma-separated, no trailing slashes)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Google Gemini API Key for Regulatory Explanations (Server-side only)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# Default Gemini Model & Fallback Priority
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash-lite,gemini-1.5-flash

# TrustFed Server Secret Key (used for token signing & HMAC validation)
# Generate a strong 32-byte secret in production using: openssl rand -hex 32
TRUSTFED_SECRET_KEY=dev-insecure-secret-key-change-in-production-32bytes-min

# Rate Limiting Controls (requests per minute)
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AI_STREAM=15/minute
RATE_LIMIT_BATCH=30/minute
